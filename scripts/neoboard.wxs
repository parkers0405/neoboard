<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NeoBoard" Manufacturer="NeoBoard contributors" Version="$(var.Version)"
           UpgradeCode="BA6BECB8-74B8-4A0C-915F-C472F47006C9" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NeoBoard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="NeoBoard.exe" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="NeoBoard.exe" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Minimal" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NeoBoard" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixUnelevatedShellExecTarget" Value="[#NeoBoardDesktopExe]" />
    <!-- Ask the interactive desktop shell, not the elevated installer service, to open the GUI. -->
    <CustomAction Id="LaunchNeoBoardDesktop" BinaryRef="Wix4UtilCA_X64" DllEntry="WixUnelevatedShellExec"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <UI>
      <!-- ExitDialog is the success dialog. Run before WixUI's Finish/EndDialog event (999). -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNeoBoardDesktop" Order="1"
               Condition='WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND UILevel = 5 AND ACTION = "INSTALL" AND NOT Installed AND NOT REMOVE AND NOT REINSTALL' />
    </UI>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NeoBoard" />
    </StandardDirectory>
    <Feature Id="Main" Title="NeoBoard" Level="1">
      <ComponentGroupRef Id="Payload" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER" Source="$(var.BinaryDir)">
      <Component><File Name="neoboard.exe" /></Component>
      <Component><File Name="neochat.exe" /></Component>
      <Component><File Name="neochatd.exe" /></Component>
      <Component><File Name="neochat-mcp.exe" /></Component>
      <Component><File Name="neochat-share.exe" /></Component>
      <Component>
        <File Id="NeoBoardDesktopExe" Name="neochat-desktop.exe">
          <Shortcut Id="LaunchNeoBoard" Directory="ProgramMenuFolder" Name="NeoBoard" Advertise="yes" WorkingDirectory="INSTALLFOLDER" Icon="NeoBoard.exe" IconIndex="0" />
        </File>
      </Component>
      <Component><File Name="LICENSE" /></Component>
      <Component><File Name="LICENSE-Rune" /></Component>
      <Component><File Name="LICENSE-winit" /></Component>
      <Component><File Name="MCP.md" /></Component>
      <Component><File Name="OFL.GeistMono.txt" /></Component>
    </ComponentGroup>
  </Fragment>
</Wix>